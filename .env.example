# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/gold_loan_portal

# Financial Business Rules
GOLD_RATE_24K_PER_GRAM=7000
MAX_ALLOWED_LTV=0.75

# AI Agent Configuration
# Optional: Provide Google Gemini or OpenAI API Key.
# If no key is provided, the system seamlessly uses the built-in Intelligent Rule Agent.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-2.5-flash
